$primary: #004578;
$secondary: #0178D4;
$accent: #ffa62b;
$warning: #ffa62b;
$error: #ba3c5b;
$success: #4EBF71;
$surface: #D8D8D8;
$panel: #D0D0D0;
$background: #E0E0E0;
$foreground: #000000;
$dark: false;

/* progress bar gradients */
$bar-gradient-default: $secondary $primary;
$bar-gradient-error: $warning $error;

/* other vars */
$footer-key-foreground: #0178D4;
